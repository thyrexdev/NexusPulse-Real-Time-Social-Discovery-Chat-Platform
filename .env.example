# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chat_db?schema=public"

# Authentication / JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRATION="7d"

# Redis (for Pub/Sub & Horizontal WebSocket Scaling)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_ENABLED="false"

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Security / CORS
CORS_ORIGIN="*"
