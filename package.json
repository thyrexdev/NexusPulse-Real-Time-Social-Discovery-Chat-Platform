{
  "name": "realtime-messaging-platform-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "NexusPulse Real-Time Social Discovery & Messaging Monorepo",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:backend": "pnpm --filter backend run start:dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "build": "pnpm --recursive run build",
    "build:backend": "pnpm --filter backend run build",
    "build:frontend": "pnpm --filter frontend run build",
    "start:backend": "pnpm --filter backend run start:prod",
    "start:frontend": "pnpm --filter frontend run start",
    "test": "pnpm --filter backend run test",
    "test:backend": "pnpm --filter backend run test",
    "test:backend:e2e": "pnpm --filter backend run test:e2e",
    "db:seed": "pnpm --filter backend run db:seed",
    "prisma:generate": "pnpm --filter backend run prisma:generate",
    "prisma:push": "pnpm --filter backend run prisma:push",
    "prisma:migrate": "pnpm --filter backend run prisma:migrate",
    "lint": "pnpm --recursive run lint"
  },
  "packageManager": "pnpm@11.24.0"
}
